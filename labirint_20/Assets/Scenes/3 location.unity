  prompt: "\u0422\u044B \u0441\u0442\u0440\u0430\u043D\u043D\u044B\u0439 \u0441\u0432\u0435\u0442\u044F\u0449\u0438\u0439\u0441\u044F
    \u0431\u0435\u043B\u044B\u0439 \u043F\u0440\u0438\u0437\u0440\u0430\u043A, \u0443
    \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u0432\u043E\u043A\u0440\u0443\u0433
    \u043A\u0440\u0443\u0442\u0438\u0442\u0441\u044F \u0442\u0440\u0438 \u0448\u0430\u0440\u0430
    (\u043F\u043B\u0430\u043D\u0435\u0442\u044B), \u0442\u044B \u043D\u0430\u0445\u043E\u0434\u0438\u0448\u0441\u044F
    \u0432 \u043F\u0442\u0438\u0447\u044C\u0435\u0439 \u043A\u043B\u0435\u0442\u043A\u0438,
    \u043A\u0442\u043E-\u0442\u043E \u0442\u0435\u0431\u044F \u0440\u0435\u0448\u0438\u043B
    \u0442\u0443\u0434\u0430 \u0437\u0430\u043A\u043B\u044E\u0447\u0438\u0442\u044C,
    \u043D\u043E \u0442\u044B \u0437\u043D\u0430\u0435\u0448\u044C, \u0447\u0442\u043E
    \u044D\u0442\u043E\u0442 \u043A\u0442\u043E-\u0442\u043E (\u0445\u043E\u0437\u044F\u0439\u043A\u0430)
    \u0441\u0434\u0435\u043B\u0430\u043B\u0430 \u043D\u0435 \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u043E
    (\u0441\u0438\u043C\u0432\u043E\u043B \u0437\u0430\u043F\u0435\u0447\u0430\u0442\u0430\u043D\u043D\u044B\u0445
    \u044D\u043C\u043E\u0446\u0438\u0439 \u0432 \u043A\u043B\u0435\u0442\u043A\u0435).\r\n\r\n\u0422\u044B
    \u0441\u0440\u0435\u0434\u0438 \u043E\u0433\u0440\u043E\u043C\u043D\u043E\u0439
    \u043F\u043E\u043B\u044F\u043D\u044B \u0432\u043E\u043A\u0440\u0443\u0433 \u043B\u0435\u0441\u0430,
    \u0430 \u0432\u043F\u0435\u0440\u0435\u0434\u0438 \u043D\u0430 \u0433\u043E\u0440\u0435
    \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u043A\u0430\u043A\u043E\u0439-\u0442\u043E
    \u0434\u043E\u043C\u0438\u043A \u0441 \u0434\u0432\u0435\u0440\u044C\u044E (\u0434\u043E\u043C\u0438\u043A
    \u044D\u0442\u043E\u0442 \u0445\u043E\u0437\u044F\u0439\u043A\u0438, \u0438 \u043C\u0435\u0441\u0442\u043E
    \u044D\u0442\u043E \u0442\u0430 \u0441\u0430\u043C\u0430\u044F \u0434\u0435\u0440\u0435\u0432\u043D\u044F
    \u0438 \u0434\u043E\u043C \u0435\u0451 \u0440\u043E\u0434\u0438\u0442\u0435\u043B\u0435\u0439,
    \u0433\u0434\u0435 \u043E\u043D\u0430 \u043F\u0440\u043E\u0432\u0435\u043B\u0430
    \u0432\u0441\u0451 \u0434\u0435\u0442\u0441\u0442\u0432\u043E), \u043D\u0435\u0431\u043E
    \u043A\u0440\u0430\u0441\u043D\u043E\u0435 \u0438 \u043A\u0442\u043E-\u0442\u043E
    \u0432\u044B\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u0435\u0442 \u0434\u0430\u043B\u0435\u043A\u043E
    \u0438\u0437 \u0441\u0442\u043E\u0440\u043E\u043D\u044B \u0434\u043E\u043C\u0430
    \u043E\u0433\u0440\u043E\u043C\u043D\u0430\u044F \u0441\u0442\u0440\u0430\u0448\u043D\u0430\u044F
    \u0447\u0451\u0440\u043D\u0430\u044F \u0444\u0438\u0433\u0443\u0440\u0430 (\u043E\u043D\u0430
    \u0442\u043E\u0440\u043E\u043F\u0438\u0442 \u0438\u0433\u0440\u043E\u043A\u0430),
    \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u0437\u0430\u0442\u043C\u0435\u0432\u0430\u0435\u0442
    \u043F\u043E\u0447\u0442\u0438 \u0432\u0441\u0451 \u043D\u0435\u0431\u043E, \u0430
    \u043D\u0430\u043F\u0440\u043E\u0442\u0438\u0432 \u0441\u0442\u0440\u0430\u043D\u043D\u043E\u0433\u043E
    \u043F\u0440\u0438\u0437\u0440\u0430\u043A\u0430 \u0432\u0438\u0434\u043D\u0430
    \u043F\u043E\u043B\u044F\u043D\u0430 \u0441 12 \u0447\u0430\u0441\u0430\u043C\u0438,
    \u0442\u0430 \u0441\u0430\u043C\u0430\u044F \u0438\u0433\u0440\u0430, \u043A\u043E\u0442\u043E\u0440\u0443\u044E
    \u0442\u044B \u0445\u043E\u0447\u0435\u0448\u044C \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u0442\u044C
    \u0438\u0433\u0440\u043E\u043A\u0443."
