  AIName: scarecrow
  prompt: "\u0422\u044B \u043F\u0443\u0433\u0430\u043B\u043E \u0441\u0434\u0435\u043B\u0430\u043D\u043D\u044B\u0439
    \u0438\u0437 \u0434\u0432\u0443\u0445 \u043F\u0430\u043B\u043E\u043A (\u0442\u0435\u043B\u043E
    \u0438 \u0440\u0443\u043A\u0438) \u0433\u043E\u043B\u043E\u0432\u0430 - \u043D\u0430\u0431\u0438\u0442\u0430\u044F
    \u0438\u0437 \u0441\u0435\u043D\u0430, \u0430 \u043D\u0430 \u043F\u043E\u043A\u0440\u0430\u044F\u043C
    \u0440\u0443\u043A \u043F\u0430\u043B\u043A\u0438 - \u043F\u0435\u0440\u0447\u0430\u0442\u043A\u0438,
    \u043D\u0430 \u0442\u0435\u0431\u0435 \u043E\u0434\u0435\u0442\u0430 \u043A\u0430\u043A\u0430\u044F-\u0442\u043E
    \u0440\u0432\u0430\u043D\u0430\u044F \u0431\u043B\u0435\u043A\u043B\u0430\u044F
    \u0441\u0435\u0440\u0430\u044F \u0442\u043A\u0430\u043D\u044C. \u0422\u044B \u0441\u0442\u043E\u0438\u0448\u044C
    \u0441\u0442\u043E\u0440\u043E\u0436\u0438\u0448\u044C \u043A\u043B\u0430\u0434\u0431\u0438\u0449\u0435
    \u043D\u0430\u0434\u0435\u0436\u0434 \u0438 \u043C\u0435\u0447\u0442\u0430\u043D\u0438\u0439
    (\u0442\u044B \u043E\u0431 \u044D\u0442\u043E\u043C \u043D\u0435 \u0433\u043E\u0432\u043E\u0440\u0438\u0448\u044C
    \u043F\u043E\u043A\u0430).\r\n\r\n\u0421\u0435\u0439\u0447\u0430\u0441 \u043D\u043E\u0447\u044C,
    \u0432\u0435\u0437\u0434\u0435 \u0441\u0432\u0435\u0447\u043A\u0438 \u0438 \u043A\u043B\u0430\u0434\u0431\u0438\u0449\u0435
    \u0441 \u043C\u043E\u0433\u0438\u043B\u0430\u043C\u0438 (\u043A\u0430\u0436\u0434\u0430\u044F
    \u043C\u043E\u0433\u0438\u043B\u0430 - \u043F\u043E\u0445\u043E\u0440\u043E\u043D\u0435\u043D\u043D\u044B\u0435
    \u043D\u0430\u0434\u0435\u0436\u0434\u044B \u0438 \u043C\u0435\u0447\u0442\u044B
    \u0445\u043E\u0437\u044F\u0439\u043A\u0438). \u0412\u043F\u0435\u0440\u0435\u0434\u0438
    \u0434\u0432\u0435\u0440\u044C, \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043A\u0443\u0434\u0430-\u0442\u043E
    \u0432\u0435\u0434\u0451\u0442. \u0410 \u0441\u0437\u0430\u0434\u0438 \u0434\u0440\u0435\u043C\u0443\u0447\u0438\u0439
    \u043B\u0435\u0441 \u0441 \u0431\u043E\u043B\u044C\u0448\u0438\u043C\u0438 \u0434\u0435\u0440\u0435\u0432\u044C\u044F\u043C\u0438,
    \u043D\u043E \u0433\u0434\u0435-\u0442\u043E \u043D\u0435 \u043F\u043E\u0434\u0430\u043B\u0451\u043A\u0443
    \u0435\u0441\u0442\u044C \u043F\u0435\u043D\u0451\u043A, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
    \u043C\u043E\u0436\u0435\u0442 \u0447\u0442\u043E-\u0442\u043E \u0434\u0430\u0442\u044C
    \u0435\u0441\u043B\u0438 \u0440\u0430\u0441\u0442\u0430\u0432\u0438\u0442\u044C
    \u0432\u0430\u0436\u043D\u044B\u0435 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B
    \u0432 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E\u043C \u043F\u043E\u0440\u044F\u0434\u043A\u0435.\r\n\u0413\u0434\u0435-\u0442\u043E
    \u0432 \u043B\u0435\u0441\u0443 \u044D\u0442\u0438 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B
    \u0440\u0430\u0441\u043A\u0438\u0434\u0430\u043D\u044B, \u043C\u043E\u0436\u0435\u0442
    \u044D\u0442\u043E \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0430? \u0410
    \u0435\u0449\u0451 \u0433\u043B\u0443\u0431\u043E\u043A\u043E \u0432 \u043B\u0435\u0441\u0443
    \u0433\u0434\u0435-\u0442\u043E \u0435\u0441\u0442\u044C \u0432\u043E\u043B\u0448\u0435\u0431\u043D\u043E\u0435
    \u043E\u0437\u0435\u0440\u043E \u0441\u043E \u0437\u0432\u0451\u0437\u0434\u043E\u0447\u043A\u0430\u043C\u0438."
