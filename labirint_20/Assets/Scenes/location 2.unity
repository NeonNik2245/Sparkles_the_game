  prompt: "\u042F \u0434\u0430\u044E \u0441\u0440\u0430\u0437\u0443 \u0447\u0435\u0442\u044B\u0440\u0435
    \u0437\u0430\u043F\u0440\u043E\u0441\u0430. \u0421\u0434\u0435\u043B\u0430\u0439
    \u043F\u043E \u043A\u0430\u0436\u0434\u043E\u043C\u0443 \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u044E
    \u0437\u0430\u043F\u0440\u043E\u0441\u0430 \u0438 \u0435\u0433\u043E \u0442\u0435\u043A\u0441\u0442\u0443.\r\n\u0412\u044B\u043F\u0438\u0448\u0438
    \u044D\u0442\u0438 \u0444\u0440\u0430\u0437\u044B  (\u043F\u0440\u043E\u043D\u043E\u043C\u0435\u0440\u0443\u0439
    \u0444\u0440\u0430\u0437\u044B \u0432\u043D\u0430\u0447\u0430\u043B\u0435 \u0442\u0438\u043F\u043E
    1. 2. 3. 4., \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u044F \u0437\u0430\u043F\u0440\u043E\u0441\u043E\u0432
    \u043D\u0435 \u043D\u0430\u0434\u043E \u043F\u0438\u0441\u0430\u0442\u044C).\r\n\u0417\u0430\u043F\u0440\u043E\u0441\u044B:\r\n\r\n1.
    \u041D\u041E\u0416\u041D\u0418\u0426\u042B:\r\n\u041E\u043F\u0438\u0448\u0438
    \u0432\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u0435 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u043E\u0433\u043E
    \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442\u0430 \u0438\u0437 \u0436\u0438\u0437\u043D\u0438
    \u0445\u043E\u0437\u044F\u0439\u043A\u0438, \u043A\u043E\u0433\u0434\u0430 \u0435\u0439
    \u0431\u044B\u043B\u043E 14 \u043B\u0435\u0442, \u043F\u0440\u043E \u043D\u043E\u0436\u043D\u0438\u0446\u044B
    (\u043A\u0430\u043A \u0432\u044B\u0440\u0435\u0437\u0430\u043B\u0430 \u0431\u0443\u043C\u0430\u0433\u0443,
    \u0434\u0435\u043B\u0430\u044F \u0433\u0435\u0440\u0431\u0430\u0440\u0438\u0438
    \u0438\u0437 \u043E\u0441\u0435\u043D\u043D\u0438\u0445 \u0436\u0451\u043B\u0442\u044B\u0445
    \u043B\u0438\u0441\u0442\u044C\u044F\u0432 \u043A\u043B\u0451\u043D\u0430, \u0438
    \u0442\u043E \u043A\u0430\u043A \u044D\u0442\u043E \u0431\u044B\u043B\u043E \u0432\u0435\u0441\u0435\u043B\u043E).\r\n(\u0441\u0444\u043E\u0440\u043C\u0443\u043B\u0438\u0440\u0443\u0439
    1 \u043A\u043E\u0440\u043E\u0442\u043A\u0443\u044E \u0444\u0440\u0430\u0437\u0443).\r\n2.
    \u0411\u0410\u041D\u0422:\r\n\u041E\u043F\u0438\u0448\u0438 \u0432\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u0435
    \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u043E\u0433\u043E \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442\u0430
    \u0438\u0437 \u0436\u0438\u0437\u043D\u0438 \u0445\u043E\u0437\u044F\u0439\u043A\u0438,
    \u043A\u043E\u0433\u0434\u0430 \u0435\u0439 \u0431\u044B\u043B\u043E 10 \u043B\u0435\u0442,
    \u043F\u0440\u043E \u043A\u0440\u0430\u0441\u043D\u044B\u0439 \u0431\u0430\u043D\u0442
    (\u043A\u0430\u043A \u043C\u0430\u043C\u0430 \u0440\u0430\u0441\u0441\u0447\u0451\u0441\u044B\u0432\u0430\u043B\u0430
    \u0432\u043E\u043B\u043E\u0441\u044B \u0438 \u0432\u0441\u0435\u0433\u0434\u0430
    \u043E\u0434\u0435\u0432\u0430\u043B\u0430 \u0435\u0439 \u044D\u0442\u043E\u0442
    \u043A\u0440\u0430\u0441\u043D\u044B\u0439 \u0431\u0430\u043D\u0442, \u0445\u043E\u0437\u044F\u0439\u043A\u0430
    \u0447\u0443\u0432\u0441\u0442\u0432\u043E\u0432\u0430\u043B\u0430 \u0442\u0435\u043F\u043B\u043E
    \u0438 \u043B\u044E\u0431\u043E\u0432\u044C \u043C\u0430\u043C\u044B).\r\n(\u0441\u0444\u043E\u0440\u043C\u0443\u043B\u0438\u0440\u0443\u0439
    1 \u043A\u043E\u0440\u043E\u0442\u043A\u0443\u044E \u0444\u0440\u0430\u0437\u0443).\r\n3.
    \u0414\u041D\u0415\u0412\u041D\u0418\u041A:\r\n\u041E\u043F\u0438\u0448\u0438
    \u0432\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u0435 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u043E\u0433\u043E
    \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442\u0430 \u0438\u0437 \u0436\u0438\u0437\u043D\u0438
    \u0445\u043E\u0437\u044F\u0439\u043A\u0438, \u043A\u043E\u0433\u0434\u0430 \u0435\u0439
    \u0431\u044B\u043B\u043E 16 \u043B\u0435\u0442, \u043F\u0440\u043E \u0434\u043D\u0435\u0432\u043D\u0438\u043A
    (\u043A\u0430\u043A\r\n\u0445\u043E\u0437\u044F\u0439\u043A\u0430 \u0437\u0430\u043F\u0438\u0441\u044B\u0432\u0430\u043B\u0430
    \u0432\u0441\u0435 \u0441\u0432\u043E\u0438 \u0441\u043E\u043A\u0440\u043E\u0432\u0435\u043D\u043D\u044B\u0435
    \u0441\u0435\u043A\u0440\u0435\u0442\u0438\u043A\u0438 \u0432 \u0434\u043D\u0435\u0432\u043D\u0438\u043A,
    \u043B\u044E\u0431\u0438\u043B\u0430 \u043D\u0430\u043A\u043B\u0435\u0432\u0438\u0432\u0430\u0442\u044C
    \u0432\u044B\u0440\u0435\u0437\u0430\u043D\u043D\u044B\u0435 \u043A\u0430\u0440\u0442\u0438\u043D\u043A\u0438
    \u0438\u0437 \u0436\u0443\u0440\u043D\u0430\u043B\u043E\u0432, \u0447\u0442\u043E\u0431\u044B
    \u043A\u0440\u0430\u0441\u0438\u0432\u043E \u043E\u0444\u043E\u0440\u043C\u0438\u0442\u044C,
    \u043D\u043E \u0431\u043E\u0438\u0442\u0441\u044F \u043A\u0430\u043A \u0431\u044B
    \u0447\u0442\u043E\u0431\u044B \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u0443\u0432\u0438\u0434\u0435\u043B
    \u044D\u0442\u043E\u0442 \u0434\u043D\u0435\u0432\u043D\u0438\u043A).\r\n(\u0441\u0444\u043E\u0440\u043C\u0443\u043B\u0438\u0440\u0443\u0439
    1 \u043A\u043E\u0440\u043E\u0442\u043A\u0443\u044E \u0444\u0440\u0430\u0437\u0443).\r\n4.
    \u041C\u041E\u0413\u0418\u041B\u0410 \u0421 \u0426\u0412\u0415\u0422\u0410\u041C\u0418:\r\n\u0422\u044B
    \u043B\u0438\u043B\u0438\u044F, \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442
    \u0441\u043E \u0441\u0442\u043E\u0440\u043E\u043D\u044B \u0432\u043E\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u0435
    \u043E \u043C\u0435\u0447\u0442\u0430\u0445 \u0438 \u043D\u0430\u0434\u0435\u0436\u0434\u0430\u0445
    \u0445\u043E\u0437\u044F\u0439\u043A\u0438, \u043C\u0435\u0447\u0442\u0430 -
    \u043E\u043D\u0430 \u0432\u0441\u0435\u0433\u0434\u0430 \u0445\u043E\u0442\u0435\u043B\u0430
    \u043F\u043E\u0435\u0445\u0430\u0442\u044C \u0432 \u0433\u043E\u0440\u043E\u0434,
    \u0433\u0434\u0435 \u0431\u0443\u0440\u043B\u0438\u0442 \u0436\u0438\u0437\u043D\u044C
    \u0438 \u0441\u0442\u0430\u0442\u044C \u043A\u0435\u043C-\u0442\u043E \u0432\u044B\u0434\u0430\u044E\u0449\u0438\u043C\u0441\u044F,
    \u0447\u0442\u043E \u0433\u043E\u0440\u0434\u0438\u043B\u0438\u0441\u044C \u0435\u0451
    \u0440\u043E\u0434\u0438\u0442\u0435\u043B\u0438, \u043D\u0430\u0434\u0435\u0436\u0434\u0430
    - \u0447\u0442\u043E \u0435\u0451 \u0437\u0430\u0433\u0430\u0434\u0430\u043D\u043D\u043E\u0435
    \u0436\u0435\u043B\u0430\u043D\u0438\u0435 \u0443\u043F\u0430\u0432\u0448\u0435\u0439
    \u0437\u0432\u0451\u0437\u0434\u043E\u0447\u043A\u0438 \u043A\u043E\u0433\u0434\u0430-\u0442\u043E
    \u0432 \u0435\u0451 \u043F\u043E\u0434\u0440\u043E\u0441\u043A\u043E\u0432\u043E\u0439
    \u0436\u0438\u0437\u043D\u0438 \u0438\u0441\u043F\u043E\u043B\u043D\u0438\u0442\u0441\u044F
    (\u043F\u0443\u0441\u0442\u044C \u0432\u0441\u0435 \u043B\u044E\u0434\u0438 \u0431\u0443\u0434\u0443\u0442
